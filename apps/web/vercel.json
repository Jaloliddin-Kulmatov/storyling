{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile --filter @storyling/web...",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/remind",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/stories",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/stories?retry=1",
      "schedule": "30 4 * * *"
    }
  ]
}
