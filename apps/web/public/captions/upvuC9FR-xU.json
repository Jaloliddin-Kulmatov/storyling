{"cues":[{"start":37.76,"end":39.04,"text":"– Hallo!"},{"start":44.32,"end":45.28,"text":"Mist!"},{"start":47.44,"end":49.08,"text":"– Ja, ich bin gut angekommen."},{"start":49.12,"end":52.76,"text":"Du kannst mir die Unterlagen für das Meeting im Hotel hinterlegen."},{"start":58.96,"end":60.92,"text":"– Cool! Noch mal!"},{"start":67.44,"end":69.72,"text":"– Ins Zentrum bitte. Zum Königshof."},{"start":69.8,"end":72.4,"text":"– Ins Zentrum. Zum Königshof."},{"start":72.72,"end":75.36,"text":"Ins Restaurant Königshof oder zum Hotel Königshof?"},{"start":75.44,"end":76.56,"text":"– Hotel Königshof."},{"start":76.68,"end":78.24,"text":"– Okay, kein Problem."},{"start":84.2,"end":86.28,"text":"– Hey, stopp!"}],"auto":false}