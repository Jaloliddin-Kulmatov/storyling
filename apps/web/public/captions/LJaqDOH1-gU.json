{"cues":[{"start":0,"end":5.28,"text":"Also meine Theorie ist das halt einmal"},{"start":2,"end":7.04,"text":"vielleicht mit damit zu tun, worauf die"},{"start":5.28,"end":9.88,"text":"amerikanische Gesellschaft, also die"},{"start":7.04,"end":12.72,"text":"US-amerikanische Gesellschaft aufgebaut"},{"start":9.88,"end":13.2,"text":"ist, dieser Freiheitsgedanke."},{"start":12.72,"end":14.64,"text":"Ja."},{"start":13.2,"end":15.72,"text":"Weil oh, denkst du nicht?"},{"start":14.64,"end":15.92,"text":"Doch doch, ja, sorry."},{"start":15.72,"end":16.68,"text":"[gelächter]"},{"start":15.92,"end":18.16,"text":"Ich hab"},{"start":16.68,"end":19.76,"text":"eine Sache, was ich in Deutschland"},{"start":18.16,"end":21.72,"text":"gelernt habe beim Deutschsprechen, es"},{"start":19.76,"end":23.48,"text":"ist sehr wichtig, ab und zu mal ja zu"},{"start":21.72,"end":26.2,"text":"sagen. Dass du dass du die Leute"},{"start":23.48,"end":26.4,"text":"signalisierst, du hörst immer noch zu."},{"start":26.2,"end":27.64,"text":"[gelächter]"},{"start":26.4,"end":29.96,"text":"Und ich wollte nur"},{"start":27.64,"end":31.68,"text":"signalisieren, ja, hab ich gehört."},{"start":29.96,"end":34.48,"text":"Jetzt ist es in Amerika nicht nötig,"},{"start":31.68,"end":35.6,"text":"dass man dem Gesprächspartner Feedback"},{"start":34.48,"end":37.84,"text":"gibt."},{"start":35.6,"end":39.12,"text":"ich finde nee, wir würden das sehr als"},{"start":37.84,"end":39.56,"text":"störend empfinden."},{"start":39.12,"end":41.12,"text":"Ah."},{"start":39.56,"end":41.92,"text":"Und Deutsch sagen wir mhm."},{"start":41.12,"end":42.32,"text":"Mhm."},{"start":41.92,"end":43.88,"text":"[gelächter]"},{"start":42.32,"end":45.36,"text":"Ja, ich finde das aber auch nervig im"},{"start":43.88,"end":49.84,"text":"Deutschen. Jemand, der immer [räuspern]"},{"start":45.36,"end":49.84,"text":"wieder mhm sagt, das ist das typische,"}],"auto":true}