{"cues":[{"start":0,"end":6.36,"text":"Welche Methode würdest du jetzt jemanden"},{"start":3.48,"end":8.32,"text":"empfehlen, jemanden, der gerade Deutsch"},{"start":6.36,"end":9.76,"text":"lernt, versucht Deutsch zu lernen?"},{"start":8.32,"end":11.32,"text":"Gerade anfängt."},{"start":9.76,"end":14.36,"text":"Anfängt, ja."},{"start":11.32,"end":16.6,"text":"Also, ich würde sagen, ähm, Filme gucken"},{"start":14.36,"end":19,"text":"mit deutschen Untertiteln. Ich würde"},{"start":16.6,"end":19.68,"text":"sagen, äh, einfache Sachen lesen und"},{"start":19,"end":21.28,"text":"manchmal gibt es ja auch so"},{"start":19.68,"end":22.48,"text":"zweisprachige Ausgaben, das ist auch"},{"start":21.28,"end":24.88,"text":"super."},{"start":22.48,"end":26.28,"text":"Ähm, und einfach herfahren. Herfahren,"},{"start":24.88,"end":26.68,"text":"herfahren, herfahren. Wobei natürlich,"},{"start":26.28,"end":27.96,"text":"also"},{"start":26.68,"end":30.16,"text":"Was bedeutet herfahren?"},{"start":27.96,"end":31.24,"text":"Na, nach Deutschland fahren."},{"start":30.16,"end":32.8,"text":"Hier, hier fahren, ja."},{"start":31.24,"end":34.44,"text":"genau, nicht in die Schweiz [gelächter]"},{"start":32.8,"end":36.12,"text":"und nicht nach Süddeutschland."},{"start":34.44,"end":37.335,"text":"Nein, auch nicht mal nach München."},{"start":36.12,"end":37.56,"text":"Nein, auf keinen Fall."},{"start":37.335,"end":39.08,"text":"[gelächter]"},{"start":37.56,"end":41.76,"text":"Und auch am besten nicht in die Stadt,"},{"start":39.08,"end":43.16,"text":"wo alle sofort Englisch reden, sondern"},{"start":41.76,"end":45.12,"text":"genau, bitte aufs Land."},{"start":43.16,"end":47.52,"text":"Einfach in die Situation begeben, indem"},{"start":45.12,"end":49.2,"text":"man die Wörter braucht. Also"},{"start":47.52,"end":51,"text":"beispielsweise, wenn man jetzt äh,"},{"start":49.2,"end":52.36,"text":"einkaufen geht oder einkaufen gehen"},{"start":51,"end":54.32,"text":"möchte, dann sollte man auch einfach"},{"start":52.36,"end":55.8,"text":"einkaufen gehen und äh, es sich dann"},{"start":54.32,"end":57.52,"text":"zwingen,"},{"start":55.8,"end":60.08,"text":"persönlich zu bestellen und äh, nicht"},{"start":57.52,"end":61.32,"text":"per App oder nicht äh, mit dem Display,"},{"start":60.08,"end":63.24,"text":"wo man drauf drückt, dann lernt man ja"},{"start":61.32,"end":64.879,"text":"auch nichts. Äh, und das ist gerade im"},{"start":63.24,"end":66.84,"text":"Kommen, ich weiß, dass äh, viel digital"},{"start":64.879,"end":68.2,"text":"gearbeitet wird, aber ich glaube, analog"},{"start":66.84,"end":70.8,"text":"lernt man immer noch am besten nicht"},{"start":68.2,"end":70.8,"text":"Fremdsprachen."}],"auto":true}