{"cues":[{"start":6.84,"end":9.32,"text":"– Tschüss, Martina. Gute Reise!"},{"start":9.36,"end":11.88,"text":"– Mach’s gut, Herbert. Bis bald!"},{"start":11.92,"end":13,"text":"– Tschüss!"},{"start":17,"end":18.96,"text":"– Auf Wiedersehen, Herr Tillmanns. Gute Reise!"},{"start":19,"end":20.84,"text":"Danke schön! Auf Wiedersehen, Frau Scholl."},{"start":32.12,"end":33.6,"text":"– Alles okay?"},{"start":35.48,"end":37.28,"text":"Brauchst du Hilfe?"},{"start":39.2,"end":41.6,"text":"Hilfe, help? Do you need help?"},{"start":42.52,"end":43.88,"text":"– Ja! Hilfe!"},{"start":44.16,"end":45.24,"text":"– Wo ist die Tasche?"},{"start":46,"end":51.68,"text":"– Die Tasche ist … gone … in the ... Taxi!"},{"start":51.8,"end":53.28,"text":"– Die Tasche ist weg in dem Taxi?"},{"start":58.2,"end":59.4,"text":"Wohin willst du?"},{"start":61.16,"end":64.08,"text":"Wohin? Willst du ins Zentrum?"},{"start":64.12,"end":65.8,"text":"– Zentrum, ja!"}],"auto":false}