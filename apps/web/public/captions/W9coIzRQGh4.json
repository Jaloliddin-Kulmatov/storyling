{"cues":[{"start":0.48,"end":3.199,"text":"Es ist wieder soweit."},{"start":3.199,"end":7.52,"text":"Unser Kühlschrank ist leer und wir müssen"},{"start":7.52,"end":8.96,"text":"Einkaufen."},{"start":8.96,"end":13.4,"text":"Vor ein paar Wochen waren wir bei einem Biomarkt."},{"start":13.4,"end":16.4,"text":"Heute gehen wir zu Edeka"},{"start":16.4,"end":18.8,"text":"Auf langsam Deutsch."},{"start":18.8,"end":21.1,"text":"Los geht's."},{"start":25.56,"end":29.119,"text":"Janusch. In unserem letzten Einkaufsvideo"},{"start":29.119,"end":32.2,"text":"Haben wir gesehen, wie du einkaufst"},{"start":32.2,"end":34.76,"text":"Ohne Liste, ohne Plan,"},{"start":34.76,"end":39.399,"text":"Ohne System. Einfach alles in den Wagen rein."},{"start":39.399,"end":41.68,"text":"Dafür mit viel Fantasie"},{"start":41.68,"end":44.579,"text":"Und mit einem sicheren"},{"start":44.64,"end":48.079,"text":"Gespür dafür, was man braucht und was nicht."},{"start":48.079,"end":51.559,"text":"Heute kaufen wir mit meinem System ein."},{"start":51.559,"end":54.16,"text":"Ich habe eine Einkaufsliste"},{"start":54.16,"end":55.48,"text":"Vorbereitet,"},{"start":55.48,"end":57.16,"text":"Die wir abarbeiten"},{"start":57.16,"end":59.92,"text":"Können und die Einkaufsliste"},{"start":59.92,"end":61.519,"text":"Ist sogar sortiert"},{"start":61.519,"end":62.76,"text":"Nach Abteilungen"},{"start":62.76,"end":64.119,"text":"Im Supermarkt."},{"start":64.119,"end":66.2,"text":"Ich bin sehr beeindruckt."},{"start":66.2,"end":70.1,"text":"Wir fangen an mit dem Lehrgut."},{"start":71.24,"end":73.72,"text":"Wir haben viel Lehrergut mitgebracht."},{"start":73.72,"end":76.74,"text":"Das macht man in Deutschland so."},{"start":78.759,"end":80.84,"text":"Was ist eigentlich"},{"start":80.84,"end":82.34,"text":"Leergut?"},{"start":82.4,"end":83.439,"text":"Leergut"},{"start":83.439,"end":85.64,"text":"Sind leere Flaschen."},{"start":85.64,"end":88.84,"text":"In Deutschland bringt man leere Flaschen"},{"start":88.84,"end":91.159,"text":"Zurück in den Supermarkt."},{"start":91.159,"end":92.32,"text":"Man bekommt"},{"start":92.32,"end":94.979,"text":"Pfand für diese Flaschen."},{"start":95.96,"end":99.72,"text":"Das System gibt es schon seit vielen Jahren"},{"start":99.72,"end":101,"text":"Und Janusch"},{"start":101,"end":102.399,"text":"Bringt regelmäßig"},{"start":102.399,"end":105.82,"text":"Seine leeren Bierflaschen zurück."},{"start":106.24,"end":109.68,"text":"Ja. Heute nur drei Flaschen Janusch"},{"start":109.68,"end":111.579,"text":"Ganz zivilisiert."},{"start":111.719,"end":114.159,"text":"So, jetzt sehen wir"},{"start":114.159,"end":115.719,"text":"Der Pfandbong"},{"start":115.719,"end":117.159,"text":"Wird gedrückt."},{"start":117.159,"end":118.659,"text":"Gedruckt."},{"start":119,"end":122.18,"text":"Das ist der Pfandbong."},{"start":122.479,"end":125.18,"text":"Da sehen wir 1,29"},{"start":125.92,"end":129.8,"text":"€ bekommen wir wieder für die Flaschen."},{"start":129.8,"end":133.48,"text":"Den Fundbong nehmen wir mit zur Kasse"},{"start":133.48,"end":136.16,"text":"Und dann gibt es eine Gutschrift"},{"start":136.16,"end":138.019,"text":"Beim Einkauf."},{"start":138.04,"end":140.8,"text":"Oder man kann das Geld auch auszahlen"},{"start":140.8,"end":142.599,"text":"Lassen, wie man will."},{"start":142.599,"end":146.879,"text":"Guck mal, Janusch, mein Traum wird wahr."},{"start":146.879,"end":148.8,"text":"Ich habe gerade"},{"start":148.8,"end":150.36,"text":"Mein veganes"},{"start":150.36,"end":151.56,"text":"Lieblingsdessert"},{"start":151.56,"end":152.959,"text":"Entdeckt."},{"start":152.959,"end":156.9,"text":"Das kenne ich bisher nur aus England."},{"start":156.959,"end":157.879,"text":"Einen"},{"start":157.879,"end":159.379,"text":"Veganer"},{"start":159.519,"end":161.019,"text":"Zitronen"},{"start":162.239,"end":163.739,"text":"Kuchendessert."},{"start":164.2,"end":168.04,"text":"Voll schön. Da nehme ich direkt vier Stück mit."},{"start":168.04,"end":171.72,"text":"Ich wusste gar nicht, dass es das"},{"start":171.72,"end":174.379,"text":"In Deutschland gibt."},{"start":174.56,"end":176.159,"text":"Ich bin begeistert."},{"start":176.159,"end":178.62,"text":"Ich freue mich für dich."},{"start":187.92,"end":189.56,"text":"Guck mal, Janusch,"},{"start":189.56,"end":192.599,"text":"Das ist richtig lecker."},{"start":192.599,"end":195.94,"text":"Ja, in Deutschland ein Klassiker."},{"start":195.959,"end":197.459,"text":"Studentenfutter."},{"start":197.599,"end":199.78,"text":"Was ist das?"},{"start":200,"end":201.92,"text":"Futter für Studenten."},{"start":201.92,"end":203.64,"text":"Es ist eine Nussmischung"},{"start":203.64,"end":205.76,"text":"Mit verschiedenen Nüssen"},{"start":205.76,"end":207.86,"text":"Und Rosinen."},{"start":208.519,"end":211.799,"text":"Gefällt dir das? Schmeckt dir das auch, Janusch?"},{"start":211.799,"end":215.239,"text":"Absolut. Ja, ich esse es nicht oft,"},{"start":215.239,"end":217.4,"text":"Aber wenn, dann genieße"},{"start":217.4,"end":219.12,"text":"Ich es."},{"start":219.12,"end":221.54,"text":"Sehr gesund Snack."},{"start":226.439,"end":228.22,"text":"Guck mal."},{"start":228.319,"end":229.72,"text":"Himbeeren."},{"start":229.72,"end":232,"text":"Himbeeren sind lecker."},{"start":232,"end":233.799,"text":"Ich esse Himbeeren"},{"start":233.799,"end":235.92,"text":"Gerne im Joghurt"},{"start":235.92,"end":238.5,"text":"Zusammen mit Bananen."},{"start":238.72,"end":241.28,"text":"Hört sich super lecker an."},{"start":241.28,"end":244.159,"text":"Was brauchst du noch aus der Gemüse"},{"start":244.159,"end":246.06,"text":"Und Obstabteilung?"},{"start":246.319,"end":250.439,"text":"Ich brauche dieses Mal etwas Petersilie."},{"start":250.439,"end":251.939,"text":"Petersilie,"},{"start":252,"end":254.099,"text":"Das ist ein"},{"start":254.599,"end":256,"text":"Kraut."},{"start":256,"end":260.82,"text":"Kraut und tatsächlich ich kaufe das zum ersten Mal in meinem Leben."},{"start":261.04,"end":263.24,"text":"Das ist gut. Hab ich gerade gelesen."},{"start":263.24,"end":265.8,"text":"Chpt PT hat gesagt, du sollst Petersilie"},{"start":265.8,"end":268.96,"text":"Kaufen. Na, dann machen wir das."},{"start":268.96,"end":270.32,"text":"Es gibt tatsächlich"},{"start":270.32,"end":274.199,"text":"In den meisten Supermärkten so eine Kräuterabteilung."},{"start":274.199,"end":278.32,"text":"Janusch, guck mal. Voll schön. Hier gibt es Schnittlauch,"},{"start":278.32,"end":279.8,"text":"Koriander,"},{"start":279.8,"end":281.3,"text":"Oregano,"},{"start":281.32,"end":282.639,"text":"Mayoran"},{"start":282.639,"end":284.139,"text":"Und"},{"start":284.32,"end":285.32,"text":"Petersilie."},{"start":285.32,"end":288,"text":"Ja, aber ich möchte lieber"},{"start":288,"end":289.94,"text":"Diese Petasilie,"},{"start":290.12,"end":294.199,"text":"Weil die kann dann ruhig weiterwachsen bei mir und ich nehme nur so ein"},{"start":294.199,"end":295.56,"text":"Bisschen davon."},{"start":295.56,"end":299.12,"text":"Die musst du aber auch gießen. Das ist eine lebende"},{"start":299.12,"end":300.62,"text":"Pflanze,"},{"start":300.72,"end":303.28,"text":"Glaubst du? Ich weiß es nicht."},{"start":303.28,"end":307.12,"text":"Ja, das glaube ich. Bei dir gehen doch die Pflanzen"},{"start":307.12,"end":309.34,"text":"Ein. Nein,"},{"start":309.8,"end":312.56,"text":"Das musst du wiederrufen, bitte. Ich wiederrufe"},{"start":312.56,"end":314.72,"text":"Das. Janus Schamerski"},{"start":314.72,"end":316.479,"text":"Ist ein Pflanzen"},{"start":316.479,"end":318.979,"text":"Ist ein echter Pflanzenfreund."},{"start":321.72,"end":326.12,"text":"Janusch, was machst du denn da? Ich guck mir die Easy German"},{"start":326.12,"end":327.96,"text":"Discord Gruppe an."},{"start":327.96,"end":330.36,"text":"Mhm. Du bist also im Kanal"},{"start":330.36,"end":334.68,"text":"Lustiges. Was gibt es da so? Es gibt viele gute Memes"},{"start":334.68,"end":337.759,"text":"Und äh eine fand ich gerade besonders"},{"start":337.759,"end":338.84,"text":"Witzig"},{"start":338.84,"end":341.8,"text":"Und ich würde das gerne vorlesen, wenn ich darf."},{"start":341.8,"end":345.12,"text":"Das Leben ist kurz. Stelle sicher, dass du"},{"start":345.12,"end":348.08,"text":"So viel Zeit wie möglich im Internet verbringst"},{"start":348.08,"end":350.539,"text":"Und mit Fremden streitest."},{"start":350.639,"end":352.28,"text":"Eine gute Idee."},{"start":352.28,"end":355.12,"text":"Ihr könnt auch mit uns Deutsch lernen mit"},{"start":355.12,"end":357.96,"text":"Witzen und könnt Mitglied werden."},{"start":357.96,"end":362.52,"text":"Discord ist einer von vielen Perks, also Zugang zu unserer Discordgruppe."},{"start":362.52,"end":365.72,"text":"Als Mitglied von Easy German unterstützt ihr unsere Arbeit"},{"start":365.72,"end":369.24,"text":"Und erhaltet viele tolle Materialien zum Deutsch lernen."},{"start":369.24,"end":372.52,"text":"Unter anderem chatten wir zusammen in diesem Kanal"},{"start":372.52,"end":374.4,"text":"Und zeigen uns gegenseitig"},{"start":374.4,"end":376.28,"text":"Witze auf Deutsch."},{"start":376.28,"end":377.639,"text":"Unter anderem"},{"start":377.639,"end":380.36,"text":"Probiert das aus. werdet ein Easy German Mitglied."},{"start":380.36,"end":383.319,"text":"Wir würden uns wahnsinnig freuen, euch kennenzulernen"},{"start":383.319,"end":386.139,"text":"Und mit euch Witze auszutauschen."},{"start":393.96,"end":398.479,"text":"Guckt mal, Leute, in diesem Edkal gibt es eine richtig"},{"start":398.479,"end":399.4,"text":"Schöne"},{"start":399.4,"end":400.84,"text":"Salatbar."},{"start":400.84,"end":404.479,"text":"Janusch, möchtest du dir einen Salat kaufen?"},{"start":404.479,"end":406.919,"text":"Es ist voll lecker."},{"start":406.919,"end":408.039,"text":"Ich glaube,"},{"start":408.039,"end":410.52,"text":"Ähm dieses Mal wird es kein Salat"},{"start":410.52,"end":413.78,"text":"Werden, sondern eine klassische"},{"start":416.12,"end":418.18,"text":"Nein, doch nicht."},{"start":418.96,"end":420.36,"text":"Hier"},{"start":420.36,"end":421.639,"text":"Eine klassische"},{"start":421.639,"end":423.139,"text":"Schweine"},{"start":424.319,"end":425.28,"text":"Haxe."},{"start":425.28,"end":429.759,"text":"Haxse. Also hier an der Salatbar gibt es auch Fleisch"},{"start":429.759,"end":432.52,"text":"Und zwar typische Sachen. Was ist das, Janus?"},{"start":432.52,"end":434.039,"text":"Eine Bullette."},{"start":434.039,"end":437.12,"text":"Eine Boulette oder auch eine Frikadelle."},{"start":437.12,"end":439.479,"text":"Ich muss sagen, die ist warm und"},{"start":439.479,"end":442.34,"text":"Sieht lecker aus. Ja,"},{"start":442.479,"end":444.36,"text":"Und diese Schweinehaxe"},{"start":444.36,"end":447.8,"text":"Hat mich dann auch wieder verführt."},{"start":447.8,"end":450.36,"text":"Wie wäre es mit Salat, Janusch?"},{"start":450.36,"end":454.16,"text":"Äh, sobald ich zu Hause bin, habe ich alle Zutaten"},{"start":454.16,"end":457.96,"text":"Für einen leckeren Salat und den werde ich dann den"},{"start":457.96,"end":462.199,"text":"Ganzen Rest des Tages essen. Zusammen mit der Schweinehachse."},{"start":462.199,"end":463.319,"text":"Die Schweinehaxse"},{"start":463.319,"end":466.479,"text":"Wird hier an Ort und Stelle verspeist."},{"start":466.479,"end":470.68,"text":"Aber erst musst du die bezahlen. Guck mal, Janusch, es gibt sogar ganze"},{"start":470.68,"end":472.56,"text":"Schnitzel hier."},{"start":472.56,"end":476.3,"text":"Sehen aus wie typische polnische Schnitzel."},{"start":488.479,"end":491.52,"text":"Guck mal, Janusch, das ist auch richtig"},{"start":491.52,"end":492.52,"text":"Typisch"},{"start":492.52,"end":495.159,"text":"Für einen deutschen Supermarkt."},{"start":495.159,"end":499.199,"text":"Deutsche lieben Brot. Also gibt es einen Bäcker"},{"start":499.199,"end":500.639,"text":"Im Supermarkt."},{"start":500.639,"end":504.44,"text":"Der Bäcker backt die ganze Zeit neue Brötchen"},{"start":504.44,"end":507.72,"text":"Und schiebt sie in diese Theke rein."},{"start":507.72,"end":510.28,"text":"Und du kannst jetzt ein frisch gebackenes"},{"start":510.28,"end":514.719,"text":"Brötchen kaufen. Ja. Und frischer kann man das gar nicht"},{"start":514.719,"end":517.919,"text":"Machen. Ja. Und man sagt in Deutschland"},{"start":517.919,"end":520.76,"text":"Auch, in diesem Moment habe ich die Qual"},{"start":520.76,"end":523.8,"text":"Der Wahl, weil es gibt so viel"},{"start":523.8,"end":526.2,"text":"Auswahl, dass ich mir erstmal"},{"start":526.2,"end":527.8,"text":"Überlegen muss,"},{"start":527.8,"end":529.08,"text":"Ähm"},{"start":529.08,"end":531.68,"text":"Was will ich eigentlich? Was willst du denn?"},{"start":531.68,"end":534.959,"text":"Ich habe mir schon was ausgeguckt"},{"start":534.959,"end":536.7,"text":"Und zwar"},{"start":538.88,"end":542.1,"text":"Man nimmt sich eine Tüte"},{"start":543.24,"end":547.019,"text":"Und dann kann man in diese Tüte"},{"start":547.48,"end":551.2,"text":"Mit der Zange ein Brötchen nehmen."},{"start":551.2,"end":554.1,"text":"Das ist ein"},{"start":554.399,"end":555.899,"text":"Steinoffenbrötchen."},{"start":556.36,"end":557.92,"text":"Sehr lecker."},{"start":557.92,"end":561.16,"text":"Janusch, kennst du nach 40 Jahren in Deutschland"},{"start":561.16,"end":564.2,"text":"Schon die Namen für die ganzen Brötchen?"},{"start":564.2,"end":567.86,"text":"Für einige, aber nicht für alle. Ja."},{"start":569.279,"end":572.24,"text":"Kari, was ist noch auf deine Liste?"},{"start":572.24,"end":575,"text":"Auf meiner Einkaufsliste"},{"start":575,"end":575.959,"text":"Ist"},{"start":575.959,"end":577.76,"text":"Noch Joghurt."},{"start":577.76,"end":580.899,"text":"Ich brauche auch Joghurt. Naturjoghurt."},{"start":582.36,"end":586.24,"text":"Jetzt stehen wir vor dem Joghurtregal"},{"start":586.24,"end":589.88,"text":"Und genau das gleiche Problem. Es gibt so viele"},{"start":589.88,"end":591.2,"text":"Naturjoghurts,"},{"start":591.2,"end":595.44,"text":"Dass ich gar nicht weiß, welches für mich das Beste ist."},{"start":595.44,"end":598.079,"text":"Ich wähle eine für dich aus."},{"start":598.079,"end":599.12,"text":"Naturjoghurt"},{"start":599.12,"end":600.6,"text":"Nennen wir"},{"start":600.6,"end":604.36,"text":"Einfach die weißen Joghurts ohne Geschmack."},{"start":604.36,"end":609.26,"text":"Janusch, wir wissen aber, dass du verrückt bist nach Kirschjoghurt"},{"start":609.399,"end":610.32,"text":"Hier."},{"start":610.32,"end":612.899,"text":"Oh, danke. Toll"},{"start":612.92,"end":615.62,"text":"Bin ich. Ich bin das tatsächlich."},{"start":615.88,"end":617.399,"text":"Für mich"},{"start":617.399,"end":619.22,"text":"Gibt es"},{"start":620.48,"end":621.72,"text":"Laktosefreie"},{"start":621.72,"end":623.22,"text":"Joghurt"},{"start":623.24,"end":625.98,"text":"L ohne Laktose."},{"start":627.72,"end":631.7,"text":"Jetzt sind wir in der Drogerieabteilung."},{"start":632.399,"end":634.64,"text":"Hier gibt es was"},{"start":634.64,"end":636.32,"text":"Alles mögliche."},{"start":636.32,"end":638.62,"text":"Klopapier z.B."},{"start":638.76,"end":640.26,"text":"Feuchttücher,"},{"start":642.32,"end":646.18,"text":"Alles mögliche. Ja, ich brauche Wattestäbchen"},{"start":646.36,"end":649.48,"text":"Und Janusch, wir brauchen Klopapier."},{"start":649.48,"end":651.959,"text":"Such dir eins aus."},{"start":651.959,"end":653.459,"text":"Äh,"},{"start":654.32,"end":655.72,"text":"Hier"},{"start":655.72,"end":657.959,"text":"Natur natürlich"},{"start":657.959,"end":659.459,"text":"Recycling."},{"start":659.519,"end":661.279,"text":"Recycling Klopapier."},{"start":661.279,"end":663.36,"text":"Das sieht aber nicht so"},{"start":663.36,"end":665.8,"text":"Schön aus. Ja, machen wir aber für die Mutter"},{"start":665.8,"end":667.7,"text":"Erde. Ja."},{"start":671.04,"end":672.54,"text":"Okay,"},{"start":673.36,"end":676.22,"text":"Mutter Erde wird's uns danken."},{"start":676.88,"end":679.839,"text":"Das ist vielleicht auch ein Kulturschock"},{"start":679.839,"end":684.48,"text":"Für einige von euch. In Deutschland wird in allen Supermärkten"},{"start":684.48,"end":686.16,"text":"Alkohol verkauft"},{"start":686.16,"end":688.639,"text":"Und zwar nicht nur Bier und Wein,"},{"start":688.639,"end":692.42,"text":"Sondern auch harter Alkohol wie z.B."},{"start":692.68,"end":695.68,"text":"Wodka. Guck mal Janusch, hier dein Lieblingswodka"},{"start":695.68,"end":698.76,"text":"Aus Polen. Sehr lecker mit Apfelsaft."},{"start":698.76,"end":701.74,"text":"Und was ist dein Lieblingsschnaps?"},{"start":702.88,"end":706.44,"text":"Gar nicht, ich trinke eigentlich wenig oder gar nicht keinen Schnaps,"},{"start":706.44,"end":709.72,"text":"Aber wenn dann diese Grassuvka oder originell"},{"start":709.72,"end":712.06,"text":"Auf polnisch Jubrufka"},{"start":712.399,"end":714.48,"text":"Mit Apfelsaft gemischt."},{"start":714.48,"end":715.519,"text":"Lecker."},{"start":715.519,"end":718.279,"text":"Guck mal und das ist mein Lieblings"},{"start":718.279,"end":719.779,"text":"Ding."},{"start":720.32,"end":724.6,"text":"Kaffeelik aus Mexiko. Ja, würde ich auch gerne so einmal sippen."},{"start":724.6,"end":725.839,"text":"Nicht wirklich."},{"start":725.839,"end":728.12,"text":"Damit will man sich nicht betrinken."},{"start":728.12,"end":731.12,"text":"Aber wir raten natürlich vom Alkoholkonsum"},{"start":731.12,"end":734.3,"text":"Ab. Alkohol ist schlecht."},{"start":735.32,"end":737.5,"text":"Ja. Ja."},{"start":740.12,"end":742.04,"text":"Guck mal, Janusch."},{"start":742.04,"end":744.16,"text":"Klopapier. Wattestäbchen."},{"start":744.16,"end":749.24,"text":"Meine Liste ist fertig. Wir haben alles auf meiner Liste eingekauft."},{"start":749.24,"end":753.6,"text":"Voll schön. und darüber hinaus auch jede Menge Sachen für mich,"},{"start":753.6,"end":756.16,"text":"Die wir eigentlich gar nicht kaufen wollten."},{"start":756.16,"end":758.44,"text":"Was machen wir jetzt? Jetzt gehen wir"},{"start":758.44,"end":761.92,"text":"Zur Kasse. Tschüss. Gar. Ja, tschüss."},{"start":761.92,"end":764.6,"text":"Janusch geht jetzt zur Kasse"},{"start":764.6,"end":767.6,"text":"Und das Besondere ist, in vielen Supermärkten"},{"start":767.6,"end":769.92,"text":"Gibt es zwei Möglichkeiten."},{"start":769.92,"end":772.16,"text":"Es gibt die normale Kasse, wo man"},{"start":772.16,"end":774.519,"text":"Bedient wird und in der Schlange steht"},{"start":774.519,"end":776.72,"text":"Und es gibt diese SB"},{"start":776.72,"end":777.68,"text":"Kassen."},{"start":777.68,"end":780.699,"text":"SB steht für Selbstbedienung."},{"start":780.72,"end":783.68,"text":"Dieses Wort findet ihr in vielen Supermärkten,"},{"start":783.68,"end":786.88,"text":"Auch z.B. an der Brottheke manchmal"},{"start":786.88,"end":788.38,"text":"Selbstbedienung."},{"start":788.56,"end":792.5,"text":"Das heißt, man muss alles selbst machen."},{"start":792.76,"end":796.699,"text":"Janusch steht jetzt an der Selbstbedienungskasse."},{"start":797.839,"end":800.88,"text":"Janusch, hast du schon mal selber"},{"start":800.88,"end":803.68,"text":"Deine Einkäufe gescannt?"},{"start":803.68,"end":805.76,"text":"Ja, ich habe das schon ein oder zweimal"},{"start":805.76,"end":809.079,"text":"Gemacht, aber normalerweise stelle ich mich an die"},{"start":809.079,"end":810.68,"text":"Analoge Kasse."},{"start":810.68,"end":812.399,"text":"Du Boomer?"},{"start":812.399,"end":815.76,"text":"Ja, sehr, sehr gerne. Boomer. Traditionell,"},{"start":815.76,"end":817.26,"text":"Gemütlich."},{"start":818.399,"end":822.079,"text":"Gefällt dir das nicht, alles selber zu scannen?"},{"start":822.079,"end":823.8,"text":"Ich habe immer Angst, dass ich irgendwas"},{"start":823.8,"end":825.3,"text":"Verbaue."},{"start":826.079,"end":830.18,"text":"Verbauen heißt, wenn man etwas falsch macht."},{"start":830.399,"end":833.22,"text":"Ja, aber es macht Spaß auch."},{"start":838.12,"end":840.779,"text":"Ja, deine unnötigen Süßigkeiten."},{"start":842.079,"end":845.62,"text":"Janusch zahlt jetzt mit der Karte."},{"start":846.639,"end":848.66,"text":"Nee, da"},{"start":857.88,"end":862.079,"text":"Janusch erster großer Auftritt an der SB-Kasse"},{"start":862.079,"end":863.399,"text":"Und Janusch,"},{"start":863.399,"end":866.1,"text":"Wie findest du die SB-Kasse?"},{"start":866.16,"end":867.36,"text":"Ja,"},{"start":867.36,"end":870.12,"text":"Toll, bis es dann nicht mehr weitergeht."},{"start":870.12,"end":872.6,"text":"Aber es gibt immer Mitarbeiter,"},{"start":872.6,"end":874.759,"text":"Die sehr"},{"start":874.759,"end":877.38,"text":"Freundliche Weise helfen."},{"start":877.56,"end":881.459,"text":"Jetzt muss Janusch alle Einkäufe einpacken."},{"start":889.48,"end":890.639,"text":"Janusch,"},{"start":890.639,"end":893.72,"text":"Wir haben wieder viel zu viel eingekauft."},{"start":893.72,"end":896.6,"text":"Oh, zu viel gibt es nicht. Wir werden davon ja einige"},{"start":896.6,"end":898.16,"text":"Wochen jetzt leben."},{"start":898.16,"end":901.839,"text":"Weißt du, wovon es auch nicht zu viel geben kann?"},{"start":901.839,"end":902.959,"text":"Deutschübungen"},{"start":902.959,"end":906.839,"text":"In der Easy German Mitgliedschaft bekommt ihr zu all unseren"},{"start":906.839,"end":907.8,"text":"Videos"},{"start":907.8,"end":912.079,"text":"Interaktive Übungen, um Vokabeln und Grammatik zu vertiefen?"},{"start":912.079,"end":914.759,"text":"Auch zu diesem Video. Probiert das mal aus,"},{"start":914.759,"end":917.16,"text":"Der Link ist hier unten. Und zum Abschluss"},{"start":917.16,"end":920.88,"text":"Bedanken wir uns noch bei EDK, dass wir hier filmen durften."},{"start":920.88,"end":922.16,"text":"Vielen Dank"},{"start":922.16,"end":925.86,"text":"Und bis bald. Ciao, tschüss."}],"auto":true}