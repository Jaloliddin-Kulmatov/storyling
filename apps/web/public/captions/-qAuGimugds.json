{"cues":[{"start":7.28,"end":8.36,"text":"– Yara."},{"start":9.88,"end":11.56,"text":"– Wer ist Yara?"},{"start":11.6,"end":15.16,"text":"– Meine ... aunt?"},{"start":15.4,"end":16.6,"text":"– Deine Tante?"},{"start":16.64,"end":21,"text":"– Nicht schlecht! Du willst zu deiner Tante? Zu Yara?"},{"start":21.56,"end":26,"text":"Hast du die Adresse? Adresse: Straße, Hausnummer?"},{"start":26.04,"end":30.56,"text":"– Andel … Adelschiffstraße?"},{"start":31,"end":32.36,"text":"– Die kenn ich nicht ..."},{"start":38.52,"end":40.2,"text":"Komm, wir helfen dir!"},{"start":40.24,"end":41.32,"text":"– Yippie!"},{"start":52.76,"end":53.76,"text":"– Emma!"},{"start":53.88,"end":55.76,"text":"– Mein Name ist Emma!"},{"start":55.92,"end":57.48,"text":"Und das ist meine Tante."},{"start":57.56,"end":58.76,"text":"– Deine Mama?"},{"start":58.84,"end":62.08,"text":"– Nein, Lisa ist nicht meine Mama. Sie ist meine Tante."},{"start":62.52,"end":63.64,"text":"Meine Mama ..."},{"start":65.8,"end":68.36,"text":"... fliegt nach Amerika. Sie arbeitet da."},{"start":69.48,"end":70.56,"text":"Bitte!"},{"start":71.6,"end":72.84,"text":"– Danke."},{"start":79.24,"end":80.4,"text":"– Nico."},{"start":80.44,"end":83.12,"text":"– Mein Name ist Nico."},{"start":83.16,"end":84.28,"text":"– Hallo, Nico."},{"start":84.56,"end":85.96,"text":"– Hallo, Emma."}],"auto":false}