{"cues":[{"start":0.599,"end":2.44,"text":"Hallo Leute,"},{"start":2.44,"end":5.96,"text":"Wir stehen gerade vor einem Supermarkt"},{"start":5.96,"end":7.399,"text":"Und Janusch"},{"start":7.399,"end":9.76,"text":"Kauft jetzt ein."},{"start":9.76,"end":13.34,"text":"Janusch, was wirst du einkaufen?"},{"start":14.28,"end":17.279,"text":"Ich bin gestern zurück aus dem Urlaub"},{"start":17.279,"end":18.4,"text":"Gekommen"},{"start":18.4,"end":22.48,"text":"Und mein Kühlschrank ist leer. Ui, das bedeutet,"},{"start":22.48,"end":23.92,"text":"Ich brauche"},{"start":23.92,"end":25.119,"text":"Alles."},{"start":25.119,"end":29.039,"text":"Janusch kauft ein und ihr seid dabei."},{"start":29.039,"end":31.22,"text":"Los. Geht's"},{"start":31.24,"end":33.399,"text":"In langsam"},{"start":33.399,"end":34.899,"text":"Deutsch?"},{"start":35.399,"end":36.36,"text":"Dance"},{"start":36.36,"end":37.86,"text":"Biomarkt."},{"start":38.04,"end":39.96,"text":"So heißt der Supermarkt,"},{"start":39.96,"end":42.52,"text":"Den wir heute besuchen."},{"start":42.52,"end":45.62,"text":"Und es ist eine Supermarktkette,"},{"start":46.16,"end":47.719,"text":"Dance Biomarkt"},{"start":47.719,"end":50.76,"text":"Gibt es überall in Deutschland."},{"start":50.76,"end":54.84,"text":"Und Janusch, was ist ein Biomarkt?"},{"start":54.84,"end":56.98,"text":"Ja, mit einem Wort:"},{"start":57.039,"end":58.199,"text":"Hochqualitative"},{"start":58.199,"end":59.44,"text":"Produkte."},{"start":59.44,"end":60.559,"text":"Biomärkte"},{"start":60.559,"end":63.039,"text":"Haben den Fokus auf"},{"start":63.039,"end":65.199,"text":"Produkte aus biologischem"},{"start":65.199,"end":66.699,"text":"Anbau."},{"start":66.799,"end":70.58,"text":"Janusch, was braucht man im Supermarkt?"},{"start":70.88,"end":72.78,"text":"Einen Einkaufskorb"},{"start":73,"end":75.58,"text":"Oder einen Einkaufswagen?"},{"start":76.4,"end":78.52,"text":"Okay, dann los."},{"start":78.52,"end":80.02,"text":"Zuerst"},{"start":81.2,"end":83.52,