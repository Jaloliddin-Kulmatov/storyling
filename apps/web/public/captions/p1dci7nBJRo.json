{"cues":[{"start":11.8,"end":15.04,"text":"– Wie ist die Hausnummer, Emma? 38 oder 83?"},{"start":15.08,"end":17.04,"text":"– Moment … elf."},{"start":18,"end":20.08,"text":"– Ah, ja. Dann sind wir richtig hier."},{"start":21.16,"end":22.12,"text":"– Da."},{"start":22.44,"end":24.44,"text":"– Wie viele Zahlen sind das?"},{"start":25.16,"end":26.28,"text":"– Wie viele?"},{"start":26.68,"end":30.28,"text":"– Das sind 31 Zahlen. – 31 …"},{"start":30.56,"end":38.76,"text":"– Eins, zwei, drei, vier, fünf …"},{"start":39.32,"end":44.12,"text":"– Eins, zwei, drei, vier, fünf."},{"start":44.84,"end":54.04,"text":"– ... sechs, sieben, acht, neun, zehn, elf, zwölf."},{"start":54.16,"end":61.56,"text":"– Sechs, sieben, acht, neun, zehn, elf, zwölf."},{"start":64.16,"end":65.52,"text":"Was ist das?"},{"start":65.6,"end":68.6,"text":"– Eine Einladung zum Geburtstag von Charlotte."},{"start":69.36,"end":70.12,"text":"– Geburtstag?"},{"start":70.48,"end":72.84,"text":"– Happy birthday to you …"},{"start":72.88,"end":74.28,"text":"– Ah, Geburtstag!"},{"start":74.32,"end":78.08,"text":"– Ja, und das hier ist ein Geschenk."},{"start":86.4,"end":88.08,"text":"– Tschüss, Nico! Bis morgen!"},{"start":90.8,"end":92.44,"text":"– Tschüss, Emma!"}],"auto":false}