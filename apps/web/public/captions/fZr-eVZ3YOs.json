{"cues":[{"start":7.08,"end":7.84,"text":"– Nico!"},{"start":8.08,"end":9.04,"text":"– Stopp!"},{"start":9.32,"end":11.72,"text":"– Sag mal, spinnst du? Was ist denn?"},{"start":11.88,"end":12.8,"text":"– Die Tasche!"},{"start":12.88,"end":14.16,"text":"– Oh, oh … – Die Tasche? Welche Tasche?"},{"start":14.24,"end":15.12,"text":"– Warte, Emma!"},{"start":15.16,"end":17.28,"text":"– Die … die Tasche in there!"},{"start":17.32,"end":18.72,"text":"– Da ist keine Tasche."},{"start":20.32,"end":24.84,"text":"– Hallo, ich bin Lisa Brunner. Das ist Nico. Nico sucht seine Tasche."},{"start":24.88,"end":25.76,"text":"– Und?"},{"start":26.52,"end":28.4,"text":"– Ist Nicos Tasche in Ihrem Taxi?"},{"start":28.44,"end":31.48,"text":"– Nicos Tasche? Nein. Die Tasche ist nicht im Taxi."},{"start":31.72,"end":32.96,"text":"– Nein."},{"start":34.32,"end":35.08,"text":"Wo?"},{"start":35.32,"end":37.48,"text":"– Keine Ahnung, wo deine Tasche ist. Hier ist die Tasche nicht."},{"start":37.64,"end":39.76,"text":"– Komm, wir suchen die Tasche!"},{"start":40.32,"end":42.56,"text":"Suchen. Komm, Nico!"}],"auto":false}