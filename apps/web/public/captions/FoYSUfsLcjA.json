{"cues":[{"start":13.08,"end":15.36,"text":"– Ich heiße Nico."},{"start":16.08,"end":17.6,"text":"– Hallo, Nico."},{"start":17.76,"end":23.08,"text":"– Hallo. Also: Hallo, wie heißt du?"},{"start":23.36,"end":28.68,"text":"Hallo, ich heiße Nico. Und wie heißt du?"},{"start":28.76,"end":31,"text":"– Ich heiße Lisa."},{"start":31.28,"end":33,"text":"– Nein, du heißt Nico."},{"start":33.36,"end":36.6,"text":"– Das ist Emma. Emma spinnt gerade."},{"start":38,"end":40.24,"text":"– Ich … heiße …"},{"start":42.32,"end":43.32,"text":"Ey!"},{"start":43.36,"end":44.4,"text":"– Emma!"},{"start":44.56,"end":48.04,"text":"– Aber jetzt ist das „N“ weg! Das war Nico!"},{"start":48.72,"end":49.72,"text":"– Ich?"},{"start":51.6,"end":54.24,"text":"– Moment bitte. Ich muss noch kurz tanken."},{"start":64.4,"end":67.52,"text":"– Taxi! Stopp!"}],"auto":false}