{"cues":[{"start":0,"end":1.16,"text":"Sagen"},{"start":1.16,"end":2.76,"text":"Ich sage"},{"start":2.76,"end":4,"text":"Ich sage: Hallo."},{"start":4,"end":5.56,"text":"Du sagst"},{"start":5.56,"end":9.4,"text":"Du sagst nichts."},{"start":9.4,"end":10.36,"text":"Er sagt"},{"start":10.36,"end":13.76,"text":"Er sagt Quatsch."},{"start":13.76,"end":15.12,"text":"Quatsch!"},{"start":15.12,"end":16.48,"text":"Sie sagt"},{"start":16.48,"end":19,"text":"Sie sagt: Aua!"},{"start":19,"end":20,"text":"Aua!"},{"start":20,"end":21.48,"text":"Es sagt"},{"start":21.48,"end":24,"text":"Es sagt mir nichts."},{"start":24,"end":25.48,"text":"Wir sagen"},{"start":25.48,"end":28.6,"text":"Wir sagen: Willkommen."},{"start":28.6,"end":30.8,"text":"Ihr sagt"},{"start":30.8,"end":32.6,"text":"Ihr sagt Tschüss."},{"start":32.6,"end":34.88,"text":"Tschüss!"},{"start":34.88,"end":36.48,"text":"Sie sagen"},{"start":36.48,"end":39.52,"text":"Sie sagen: Auf Wiedersehen."},{"start":39.52,"end":42.44,"text":"Auf Wiedersehen! - Auf Wiedersehen!"},{"start":42.44,"end":43.44,"text":"Machen"},{"start":43.44,"end":44.56,"text":"Ich mache"},{"start":44.56,"end":47.6,"text":"Ich mache ein Video für euch."},{"start":47.6,"end":49.36,"text":"Du machst"},{"start":49.36,"end":52.28,"text":"Du machst mit."},{"start":52.28,"end":53.6,"text":"Er macht"},{"start":53.6,"end":57.48,"text":"Er macht nichts."},{"start":57.48,"end":58.72,"text":"Sie macht"},{"start":58.72,"end":61.88,"text":"Sie macht mich verrückt."},{"start":61.88,"end":63.8,"text":"Es macht"},{"start":63.8,"end":67.8,"text":"Es macht alles keinen Sinn."},{"start":67.8,"end":69.12,"text":"Wir machen"},{"start":69.12,"end":76.6,"text":"Wir machen etwas Geheimes."},{"start":76.6,"end":77.76,"text":"Ihr macht"},{"start":77.76,"end":81.48,"text":"Ihr macht uns glücklich mit einem Like."},{"start":81.48,"end":82.84,"text":"Sie machen"},{"start":82.84,"end":90.8,"text":"Sie machen Krach."},{"start":90.8,"end":91.28,"text":"Hören"},{"start":91.28,"end":92.84,"text":"Ich höre"},{"start":92.84,"end":101.72,"text":"Ich höre Cari und Ana."},{"start":101.72,"end":103.24,"text":"Du hörst"},{"start":103.24,"end":106.44,"text":"Du hörst mir nicht zu."},{"start":106.44,"end":107.96,"text":"Er hört"},{"start":107.96,"end":111.16,"text":"Er hört nichts."},{"start":111.16,"end":113.12,"text":"Sie hört"},{"start":113.12,"end":117.6,"text":"Sie hört Stimmen."},{"start":117.6,"end":119.56,"text":"Es hört"},{"start":119.56,"end":124.92,"text":"Es hört sich gut an."},{"start":124.92,"end":126.64,"text":"Wir hören"},{"start":126.64,"end":137.8,"text":"Wir hören Musik."},{"start":137.8,"end":138.6,"text":"Ihr hört"},{"start":138.6,"end":142.36,"text":"Cari, Michael!"},{"start":142.36,"end":144.72,"text":"Ihr hört mich nicht."},{"start":144.72,"end":146.4,"text":"Sie hören"},{"start":146.4,"end":150.64,"text":"Sie hören mir nicht zu."},{"start":150.64,"end":154.2,"text":"Und jetzt seid ihr dran: In unserer App Seedlang"},{"start":154.2,"end":157.4,"text":"könnt ihr selbst interaktiv die Konjugationen"},{"start":157.4,"end":160.76,"text":"von deutschen Verben üben. Unter anderem könnt ihr dort"},{"start":160.76,"end":164.16,"text":"eure Aussprache üben und ihr könnt auf die Untertitel"},{"start":164.16,"end":167.56,"text":"draufklicken und dort Informationen zur Grammatik"},{"start":167.56,"end":170.92,"text":"und zu den Übersetzungen erhalten. Probiert es mal aus,"},{"start":170.92,"end":174.44,"text":"hier geht es direkt zu Seedlang und hier könnt ihr"},{"start":174.44,"end":178.4,"text":"Easy German abonnieren und das solltet hr unbedingt machen."},{"start":178.4,"end":186.68,"text":"Viel Spaß und bis nächste Woche!"}],"auto":false}