{"cues":[{"start":10.48,"end":13.04,"text":"– Guten Morgen, Herr Müller, wie geht es Ihnen?"},{"start":13.12,"end":17.76,"text":"– Guten Morgen, Frau Schneider. Danke, gut! Und Ihnen?"},{"start":17.84,"end":20.48,"text":"– Guten Morgen, Herr Müller, wie geht es Ihnen?"},{"start":20.56,"end":24.4,"text":"– Guten Morgen, Frau Schneider. Danke, gut! Und Ihnen?"},{"start":26.52,"end":27.76,"text":"– Guten Tag, Frau Kamp."},{"start":27.84,"end":29.84,"text":"– Guten Tag! Wie geht es Ihnen?"},{"start":29.88,"end":32.4,"text":"– Sehr gut, danke. Und Ihnen?"},{"start":34.24,"end":36.68,"text":"– Hey, Lena! Na, wie geht’s?"},{"start":36.76,"end":37.96,"text":"– Hallo, Opa!"},{"start":39.52,"end":41.76,"text":"– Hallo, Sarah. Wie geht’s dir?"},{"start":41.8,"end":43.96,"text":"– Hi, Tom! Super, danke."},{"start":44.04,"end":44.84,"text":"Und dir?"},{"start":47.96,"end":49.48,"text":"– Oh, schön!"},{"start":50.76,"end":51.4,"text":"– Hm?"},{"start":51.56,"end":52.96,"text":"– Die Tasche ist schön!"},{"start":53.4,"end":55.96,"text":"– Entschuldigung? Schön?"},{"start":56.32,"end":57.56,"text":"– Ja, die Tasche!"},{"start":63,"end":65.84,"text":"– Emma, komm jetzt! Entschuldigung!"},{"start":73.68,"end":76.68,"text":"– Adalbert-Stifter-Straße …"}],"auto":false}