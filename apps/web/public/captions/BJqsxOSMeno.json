{"cues":[{"start":0,"end":3.64,"text":"Was"},{"start":2.24,"end":6.76,"text":"ist das?"},{"start":3.64,"end":9.84,"text":"Das sind drei Bockwürste."},{"start":6.76,"end":11.04,"text":"Das ist eine Wiener, ein Wiener Wurst."},{"start":9.84,"end":12.4,"text":"Ah, Wiener Wurst."},{"start":11.04,"end":14.12,"text":"Ein Wiener Würstchen."},{"start":12.4,"end":16.56,"text":"Bitte nur so viel abschneiden."},{"start":14.12,"end":17.76,"text":"Janosch probiert ein Stück Wiener"},{"start":16.56,"end":18.76,"text":"Würstchen."},{"start":17.76,"end":19.44,"text":"Aber"},{"start":18.76,"end":22.88,"text":"Ja."},{"start":19.44,"end":25.44,"text":"Kein Wiener Würstchen ohne Senf."},{"start":22.88,"end":28.12,"text":"Ich habe auch Senf gekauft für dich."},{"start":25.44,"end":29.92,"text":"Mhm. Wär's mal am Rand von meinem"},{"start":28.12,"end":33.08,"text":"Teller, danke."},{"start":29.92,"end":34.4,"text":"Janosch isst man die Wurst warm oder"},{"start":33.08,"end":37.16,"text":"kalt?"},{"start":34.4,"end":38.645,"text":"Eigentlich immer warm, aber unsere Wurst"},{"start":37.16,"end":39.64,"text":"ist kalt."},{"start":38.645,"end":43.84,"text":"[gelächter]"},{"start":39.64,"end":44.76,"text":"Man kann eine Wiener Wurst warm und kalt"},{"start":43.84,"end":47.815,"text":"essen."},{"start":44.76,"end":48.48,"text":"Mag ich nicht kalt."},{"start":47.815,"end":51.56,"text":"[gelächter]"},{"start":48.48,"end":51.56,"text":"Nicht zu empfehlen."}],"auto":true}