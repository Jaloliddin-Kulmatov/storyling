{"cues":[{"start":3.2,"end":6.44,"text":"Okay,"},{"start":4.68,"end":8.84,"text":"wir hatten heute 56 Abreisen, also"},{"start":6.44,"end":10.72,"text":"ziemlich viel zu tun. Mussten auch viele"},{"start":8.84,"end":12.84,"text":"E-Mails rausschicken mit Rechnungen"},{"start":10.72,"end":15.16,"text":"ähnlichen. Dann"},{"start":12.84,"end":16.68,"text":"kam gerade die Dame aus der 3916. Sie"},{"start":15.16,"end":18,"text":"fragte zwischenzeitlich nach einem"},{"start":16.68,"end":20.36,"text":"Regenschirm, den sie wohl auf dem Zimmer"},{"start":18,"end":21.92,"text":"vergessen hat, was laut dem Housekeeping"},{"start":20.36,"end":24.64,"text":"aber gar nicht der Fall ist. Wir haben"},{"start":21.92,"end":26.04,"text":"zwei VIP-Gäste auf Anreise."},{"start":24.64,"end":28.88,"text":"Da haben wir auch VIP-Treatment im"},{"start":26.04,"end":30.8,"text":"Zimmer. Bitte die Zimmer nicht tauschen."},{"start":28.88,"end":32.48,"text":"Also bei einer Schichtübergabe geht es"},{"start":30.8,"end":35.16,"text":"darum, dass der Frühdienst dem"},{"start":32.48,"end":37.44,"text":"Spätdienst alle offenen Aufgaben,"},{"start":35.16,"end":39.72,"text":"Prioritäten des Tages und besondere"},{"start":37.44,"end":42.28,"text":"Vorkommnisse übergibt, damit der"},{"start":39.72,"end":43.8,"text":"Spätdienst ohne Probleme weiterarbeiten"},{"start":42.28,"end":45.16,"text":"kann."},{"start":43.8,"end":46.88,"text":"Wenn irgendwelche offenen Fragen an der"},{"start":45.16,"end":48.96,"text":"Rezeption sind, werde ich als"},{"start":46.88,"end":50.36,"text":"Ansprechpartner meistens gewählt. Wir"},{"start":48.96,"end":53.08,"text":"sind in der Reservierungsabteilung dafür"},{"start":50.36,"end":54.92,"text":"da, hauptsächlich das Haus mit Gästen zu"},{"start":53.08,"end":57.48,"text":"füllen. Und hier ist halt die erste"},{"start":54.92,"end":59.6,"text":"Anlaufstelle und wir müssen halt"},{"start":57.48,"end":62.12,"text":"verkaufen am Telefon, sowie auch unsere"},{"start":59.6,"end":63.92,"text":"Angebote per E-Mail verschicken und im"},{"start":62.12,"end":65.64,"text":"besten Fall wird es dann gebucht. Also"},{"start":63.92,"end":67.6,"text":"Kapazitäten haben wir auf jeden Fall"},{"start":65.64,"end":71.28,"text":"verfügbar. Ich schaue gerade mal, wo die"},{"start":67.6,"end":72.16,"text":"Zimmerrate liegt in dem Zeitraum."},{"start":71.28,"end":73.68,"text":"Die Rezeption ist meine"},{"start":72.16,"end":75.92,"text":"Lieblingsabteilung,"},{"start":73.68,"end":77.4,"text":"weil man hier sehr viel mit den Gästen"},{"start":75.92,"end":80.48,"text":"zu tun hat, aber nicht nur mit den"},{"start":77.4,"end":81.32,"text":"Gästen, sondern auch am Computer sitzt."},{"start":80.48,"end":83.6,"text":"Guten Tag."},{"start":81.32,"end":84.68,"text":"Guten Tag, Williger mein Name. Ich würde"},{"start":83.6,"end":85.12,"text":"gerne einchecken."},{"start":84.68,"end":86.8,"text":"Ja."},{"start":85.12,"end":90.24,"text":"Zwei Nächte habe ich gebucht."},{"start":86.8,"end":90.24,"text":"Ja, ein Moment."},{"start":90.44,"end":93.68,"text":"An der Rezeption, da werde ich auch"},{"start":92.2,"end":94.64,"text":"manchmal alleine gelassen. Ich finde"},{"start":93.68,"end":96.92,"text":"auch schon, dass eine große"},{"start":94.64,"end":99.36,"text":"Verantwortung. Und ich finde das auch"},{"start":96.92,"end":101.04,"text":"gut, dass sie mir das zutrauen."},{"start":99.36,"end":102.48,"text":"Dann würde ich Sie dazu bitten, noch mal"},{"start":101.04,"end":105.96,"text":"die Daten zu kontrollieren und Ihre"},{"start":102.48,"end":106.84,"text":"Unterschrift zu setzen."},{"start":105.96,"end":107.64,"text":"Vielen Dank."},{"start":106.84,"end":109.48,"text":"Gerne."},{"start":107.64,"end":111.4,"text":"So, das ist für Sie. Das ist Ihre"},{"start":109.48,"end":113.32,"text":"Zimmerkarte. Hier stehen noch die"},{"start":111.4,"end":115.8,"text":"Frühstückszeiten und die WLAN-Zugänge"},{"start":113.32,"end":117.72,"text":"drauf. Frühstück befindet sich geradeaus"},{"start":115.8,"end":120.172,"text":"in unserem Bistro. Das Bistro hat bis"},{"start":117.72,"end":121.172,"text":"22:00 Uhr geöffnet und die Küche bis 21"},{"start":120.172,"end":121.932,"text":"Uhr."},{"start":121.172,"end":122.772,"text":"Dann wünsche ich Ihnen noch einen"},{"start":121.932,"end":124.292,"text":"schönen Aufenthalt."},{"start":122.772,"end":124.772,"text":"Ja, herzlichen Dank. Bitte schön."},{"start":124.292,"end":126.772,"text":"Tschüss."},{"start":124.772,"end":126.772,"text":"Tschüss."}],"auto":true}