# Optional. Set one key to turn on the AI tutor, AI import and "Story for me".
# Groq is used when both are set.
GROQ_API_KEY=
# Groq model (optional, default llama-3.3-70b-versatile)
GROQ_MODEL=
ANTHROPIC_API_KEY=
# Optional. AI requests allowed per visitor IP per day (default 40).
AI_DAILY_LIMIT=40

# Optional. Postgres connection string (e.g. from Neon) turns on accounts, sync and the leaderboard.
DATABASE_URL=
# Optional. Secret for signing sessions. Defaults to a value derived from DATABASE_URL.
AUTH_SECRET=
